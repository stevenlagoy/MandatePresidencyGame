<td><span typeof="mw:File"><a href="/wiki/File:Map_of_Vermont_highlighting_Windham_County.svg" class="mw-file-description" title="State map highlighting Windham County"><img alt="State map highlighting Windham County" src="//upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Map_of_Vermont_highlighting_Windham_County.svg/120px-Map_of_Vermont_highlighting_Windham_County.svg.png" decoding="async" width="80" height="130" class="mw-file-element" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Map_of_Vermont_highlighting_Windham_County.svg/250px-Map_of_Vermont_highlighting_Windham_County.svg.png 2x" data-file-width="627" data-file-height="1020" /></a></span>
</td></tr>
