</td>
<td><a href="/wiki/Kemmerer,_Wyoming" title="Kemmerer, Wyoming">Kemmerer</a></td>
<td>1911</td>
<td>Part of Uinta County.</td>
<td><a href="/wiki/Abraham_Lincoln" title="Abraham Lincoln">Abraham Lincoln</a> <small>(1809–65)</small>, U.S. President <small>(1861–65)</small>
</td>
<td><span data-sort-value="7004210000000000000♠">21,000</span>
</td>
<td><span data-sort-value="7003406900000000000♠">4,069</span>&#160;sq&#160;mi<br />(<span data-sort-value="7004105390000000000♠">10,539</span>&#160;km<sup>2</sup>)</td>
<td><span typeof="mw:File"><a href="/wiki/File:Map_of_Wyoming_highlighting_Lincoln_County.svg" class="mw-file-description" title="State map highlighting Lincoln County"><img alt="State map highlighting Lincoln County" src="//upload.wikimedia.org/wikipedia/commons/thumb/1/19/Map_of_Wyoming_highlighting_Lincoln_County.svg/120px-Map_of_Wyoming_highlighting_Lincoln_County.svg.png" decoding="async" width="100" height="77" class="mw-file-element" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/1/19/Map_of_Wyoming_highlighting_Lincoln_County.svg/250px-Map_of_Wyoming_highlighting_Lincoln_County.svg.png 1.5x" data-file-width="1471" data-file-height="1126" /></a></span>
