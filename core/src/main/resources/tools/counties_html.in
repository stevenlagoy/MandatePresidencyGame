<td><span data-sort-value="7001260000000000000♠">26</span>&#160;sq&#160;mi<br />(<span data-sort-value="7001670000000000000♠">67</span>&#160;km<sup>2</sup>)</td>
<td><span typeof="mw:File"><a href="/wiki/File:Map_of_Virginia_highlighting_Arlington_County.svg" class="mw-file-description" title="State map highlighting Arlington County"><img alt="State map highlighting Arlington County" src="//upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Map_of_Virginia_highlighting_Arlington_County.svg/250px-Map_of_Virginia_highlighting_Arlington_County.svg.png" decoding="async" width="150" height="65" class="mw-file-element" srcset="//upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Map_of_Virginia_highlighting_Arlington_County.svg/330px-Map_of_Virginia_highlighting_Arlington_County.svg.png 2x" data-file-width="2495" data-file-height="1082" /></a></span>
</td></tr>
<tr>
