<td><a rel="nofollow" class="external text" href="http://www.census.gov/quickfacts/table/PST045215/51007,00">007</a>
</td>
<td><a href="/wiki/Amelia,_Virginia" class="mw-redirect" title="Amelia, Virginia">Amelia</a></td>
<td>1735</td>
<td>Formed from <a href="/wiki/Brunswick_County,_Virginia" title="Brunswick County, Virginia">Brunswick</a> and <a href="/wiki/Prince_George_County,_Virginia" title="Prince George County, Virginia">Prince George</a> counties</td>
<td><a href="/wiki/Princess_Amelia_of_Great_Britain" title="Princess Amelia of Great Britain">Princess Amelia Sophia</a>, second daughter of <a href="/wiki/George_II_of_Great_Britain" title="George II of Great Britain">George II of Great Britain</a>
</td>
